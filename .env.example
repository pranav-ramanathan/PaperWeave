# Copy to apps/web/.env.local for local development. These match infra/compose.yaml.
DATABASE_URL=postgres://paperweave:paperweave@localhost:5432/paperweave
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=paperweave
S3_REGION=us-east-1
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
# Sign-in. Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Email goes to the local mail catcher: read it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=PaperWeave <no-reply@localhost>
# Live editing. The browser connects to SYNC_URL; the sync server listens on SYNC_PORT.
SYNC_URL=ws://localhost:4100
SYNC_PORT=4100
# Set to let whoever sends it read the sync server's /metrics page (counts only, no text).
# METRICS_TOKEN=
# Where DOI lookups go. Only the DOI is sent.
# CROSSREF_URL=https://api.crossref.org
# Spelling and grammar: the LanguageTool server in infra/compose.yaml. Leave unset to go without.
GRAMMAR_URL=http://localhost:8010
# Reviews by a language model. Off unless both lines are set, and then only for papers whose
# owner allows it. A review sends the selected passage to the provider; check its retention
# terms first.
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
